{
  "name": "project-hub",
  "version": "0.1.0",
  "description": "跨平台项目管家 - 统一管理本地与云端项目的运行/打包/部署",
  "main": "./out/main/index.js",
  "author": "anpy",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package:win": "npm run build && electron-builder --win --publish never",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "test:delivery": "node --import tsx --test tests/deployment.test.ts",
    "test:delivery-ui": "npm run build && node tests/run-electron-delivery-smoke.cjs",
    "test:skills": "node --import tsx --test tests/skills.test.ts",
    "test:skills-ui": "npm run build && node tests/run-electron-skills-smoke.cjs",
    "test:agent": "node --import tsx --test tests/agent-protocol.test.ts",
    "test:agent-ui": "npm run build && node tests/run-electron-agent-smoke.cjs",
    "test:build-targets": "npm run build && node tests/run-build-targets.cjs",
    "test:openclaw": "node --import tsx --test tests/openclaw-protocol.test.ts tests/openclaw-http.test.ts",
    "test:openclaw-ui": "npm run build && node tests/run-electron-openclaw-smoke.cjs",
    "test:library": "node --import tsx --test tests/library-source.test.ts tests/ragflow-client.test.ts",
    "test:library-ui": "npm run build && node tests/run-electron-library-smoke.cjs",
    "test:startup": "electron-vite build --mode development && node tests/run-electron-startup-smoke.cjs && npm run build && node tests/run-electron-startup-smoke.cjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "better-sqlite3": "^11.3.0",
    "electron-log": "^5.1.7",
    "fflate": "^0.8.3",
    "linkedom": "^0.18.13",
    "markdown-it": "^14.3.2",
    "ssh2": "^1.17.0",
    "ws": "^8.22.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@element-plus/icons-vue": "^2.3.1",
    "@types/better-sqlite3": "^7.6.11",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^22.5.0",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-vue": "^5.1.2",
    "@vue/tsconfig": "^0.5.1",
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^2.3.0",
    "element-plus": "^2.8.0",
    "pinia": "^2.2.2",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4",
    "unplugin-auto-import": "^0.18.2",
    "unplugin-vue-components": "^0.27.4",
    "vite": "^5.4.0",
    "vue": "^3.4.38",
    "vue-router": "^4.4.3",
    "vue-tsc": "^2.0.29"
  }
}
